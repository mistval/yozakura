{
  "name": "yozakura-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "mistval",
  "description": "Yozakura is an AI-powered social simulation engine.",
  "scripts": {
    "dev": "tsx watch index.ts",
    "start": "tsx index.ts",
    "pack:demo": "tsx scripts/pack_demo.ts",
    "build": "npm run pack:demo && tsc --noEmit false --outDir dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.2.0",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "lru-cache": "^11.5.1",
    "p-queue": "^10.0.0",
    "undici": "^8.12.3",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.16.0",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.20.6"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "lzma-native@8.0.6": true,
    "better-sqlite3@12.11.1": false
  }
}
