{
  "name": "Antigravity Sandbox",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "customizations": {
    "vscode": {
      "extensions": [
        "Google.google-antigravity"
      ],
      "settings": {
        "google.antigravity.enableTerminalSandbox": false,
        "google.antigravity.toolPermission": "proceed",
        "google.antigravity.allowNonWorkspaceAccess": false
      }
    }
  },
  "mounts": [
    "source=antigravity-session-cache,target=/home/node/.gemini,type=volume"
  ],
  "postCreateCommand": "sudo chown -R node:node /home/node/.gemini && npm install && npm install --prefix client && npm install --prefix server && npm install --prefix docs"
}
